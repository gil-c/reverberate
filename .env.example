# Required environment variables for reverberate. Never commit real values here;
# this file only documents names. Locally these are supplied by KeePassXC via
# `python -m reverberate.auth` (see README.md); in CI they are GitHub Actions
# secrets set manually by the repository owner.

# API key for the GPU rental service (Vast.ai), used only during Phase 2
# training if CPU training is not fast enough. See ROADMAP.md section 10.
VASTAI_API_KEY=
